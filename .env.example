# Copy this file to .env and replace the placeholder with a strong local-only password.
# SQL Server requires at least 8 characters from at least three character classes.
MSSQL_SA_PASSWORD='ReplaceWithAStrongLocalPassword123!'

# Export this as ConnectionStrings__TillApp when running the API or EF commands.
# Replace the password placeholder with the same local-only password used above.
TILLAPP_CONNECTION_STRING='Server=localhost,1433;Database=TillApp;User Id=sa;Password=ReplaceWithAStrongLocalPassword123!;TrustServerCertificate=True;Encrypt=True'
