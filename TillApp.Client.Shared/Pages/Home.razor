@page "/"

<PageTitle>TillApp</PageTitle>

<section class="hero">
    <p class="eyebrow">Simple counter ordering</p>
    <h1>Welcome to TillApp</h1>
    <p class="hero-copy">Build a food order in a few taps, then keep the unpaid queue moving.</p>
    <div class="hero-actions">
        <a class="button button-primary" href="/orders/new">Create a new order</a>
        <a class="button button-secondary" href="/orders">View unpaid orders</a>
    </div>
</section>

<section class="feature-grid" aria-label="TillApp workflow">
    <article class="feature-card">
        <span class="step-number">1</span>
        <h2>Build</h2>
        <p>Choose products and see the total update instantly.</p>
    </article>
    <article class="feature-card">
        <span class="step-number">2</span>
        <h2>Place</h2>
        <p>Send the order securely to the TillApp API.</p>
    </article>
    <article class="feature-card">
        <span class="step-number">3</span>
        <h2>Settle</h2>
        <p>Review unpaid orders and mark them paid.</p>
    </article>
</section>
