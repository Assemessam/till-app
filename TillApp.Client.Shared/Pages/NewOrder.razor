@page "/orders/new"
@inject IOrdersApiClient OrdersApiClient

<PageTitle>New Order | TillApp</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Point of sale</p>
        <h1>New Order</h1>
        <p>Build the order here. The API confirms current prices and calculates the final total.</p>
    </div>
    <a class="text-link" href="/orders">View orders</a>
</div>

@if (_successMessage is not null)
{
    <div class="status-message status-success" role="status">@_successMessage</div>
}

@if (_errorMessage is not null)
{
    <div class="status-message status-error" role="alert">
        <strong>@_errorTitle</strong>
        <span>@_errorMessage</span>
        @if (_serverValidationErrors.Count > 0)
        {
            <ul>
                @foreach (var error in _serverValidationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        }
        @if (_canReloadCatalogue)
        {
            <button type="button" class="button button-secondary" disabled="@_isLoadingCatalogue" @onclick="LoadCatalogueAsync">
                Reload catalogue
            </button>
        }
    </div>
}

@if (_isLoadingCatalogue)
{
    <div class="state-panel" role="status" aria-live="polite">
        <span class="spinner spinner-dark" aria-hidden="true"></span>
        <strong>Loading available products…</strong>
    </div>
}
else if (_catalogueUnavailable)
{
    <div class="state-panel state-error" role="alert">
        <strong>Products are unavailable.</strong>
        <span>Reload the catalogue to continue creating an order.</span>
        <button type="button" class="button button-secondary" @onclick="LoadCatalogueAsync">Reload catalogue</button>
    </div>
}
else
{
    <EditForm EditContext="_editContext"
              OnValidSubmit="PlaceOrderAsync"
              OnInvalidSubmit="HandleInvalidSubmit"
              class="pos-workspace">
        <DataAnnotationsValidator />

        <section class="panel pos-catalogue-panel">
            <div class="field-group pos-order-name">
                <label for="order-name">Order name</label>
                <InputText id="order-name"
                           class="text-input"
                           maxlength="100"
                           autocomplete="off"
                           placeholder="e.g. Table 4, Takeaway, or John"
                           disabled="@_isSubmitting"
                           @bind-Value="_model.OrderName" />
                <ValidationMessage For="@(() => _model.OrderName)" />
            </div>

            <section aria-labelledby="category-filter-heading">
                <div class="pos-section-heading">
                    <div>
                        <span class="section-step">Step 1</span>
                        <h2 id="category-filter-heading">Choose a category</h2>
                    </div>
                    <span class="item-count">@ActiveProducts.Count available</span>
                </div>
                <div class="category-filter" role="group" aria-label="Product category">
                    <button type="button"
                            class="category-button @CategoryButtonClass(null)"
                            aria-pressed="@(_selectedCategoryId is null)"
                            disabled="@_isSubmitting"
                            @onclick="() => SelectCategory(null)">
                        All
                    </button>
                    @foreach (var category in _categories)
                    {
                        <button type="button"
                                class="category-button @CategoryButtonClass(category.CategoryId)"
                                aria-pressed="@(_selectedCategoryId == category.CategoryId)"
                                disabled="@_isSubmitting"
                                @onclick="() => SelectCategory(category.CategoryId)">
                            @category.Name
                        </button>
                    }
                </div>
            </section>

            <section class="pos-products" aria-labelledby="products-heading">
                <div class="pos-section-heading">
                    <div>
                        <span class="section-step">Step 2</span>
                        <h2 id="products-heading">Add products</h2>
                    </div>
                </div>
                @if (VisibleProducts.Count == 0)
                {
                    <div class="catalog-empty">No active products are available in this category.</div>
                }
                else
                {
                    <div class="pos-product-grid">
                        @foreach (var product in VisibleProducts)
                        {
                            <button type="button"
                                    class="pos-product-button"
                                    disabled="@_isSubmitting"
                                    @onclick="() => AddProduct(product)">
                                <span>@product.Name</span>
                                <strong>@FormatCurrency(product.UnitPrice)</strong>
                            </button>
                        }
                    </div>
                }
            </section>
        </section>

        <section class="panel pos-cart-panel" aria-labelledby="current-order-heading">
            <div class="pos-section-heading">
                <div>
                    <span class="section-step">Step 3</span>
                    <h2 id="current-order-heading">Current order</h2>
                </div>
                <span class="item-count">@ItemCountLabel</span>
            </div>

            @if (_model.Items.Count == 0)
            {
                <div class="empty-basket">
                    <strong>Your cart is empty</strong>
                    <span>Add products from the catalogue to start this order.</span>
                </div>
            }
            else
            {
                <ul class="pos-cart-items">
                    @foreach (var item in _model.Items)
                    {
                        <li @key="item.ProductId">
                            <div class="pos-cart-item-name">
                                <strong>@item.ProductName</strong>
                                <span>@FormatCurrency(item.UnitPrice) each</span>
                            </div>
                            <strong class="pos-line-total">@FormatCurrency(item.LineTotal)</strong>
                            <div class="quantity-controls" aria-label="Quantity controls for @item.ProductName">
                                <button type="button"
                                        class="quantity-button"
                                        disabled="@_isSubmitting"
                                        aria-label="Remove one @item.ProductName"
                                        @onclick="() => DecrementProduct(item.ProductId)">
                                    −
                                </button>
                                <span aria-label="@item.Quantity @item.ProductName">@item.Quantity</span>
                                <button type="button"
                                        class="quantity-button"
                                        disabled="@_isSubmitting"
                                        aria-label="Add one @item.ProductName"
                                        @onclick="() => IncrementProduct(item.ProductId)">
                                    +
                                </button>
                            </div>
                            <button type="button"
                                    class="remove-button"
                                    disabled="@_isSubmitting"
                                    @onclick="() => RemoveProduct(item.ProductId)">
                                Remove
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="order-total" aria-live="polite">
                <span>Preview total</span>
                <strong>@FormatCurrency(_model.Total)</strong>
            </div>
            <p class="field-hint">The final total is calculated by the API using current product prices.</p>
            <ValidationMessage For="@(() => _model.Items)" />

            <div class="pos-actions">
                <button type="button" class="button button-secondary" disabled="@(_isSubmitting || _model.Items.Count == 0)" @onclick="ClearOrder">
                    Clear Order
                </button>
                <button type="submit" class="button button-primary" disabled="@(_isSubmitting || _catalogueUnavailable)">
                    @if (_isSubmitting)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>Placing order…</span>
                    }
                    else
                    {
                        <span>Place Order</span>
                    }
                </button>
            </div>
        </section>
    </EditForm>
}

@code {
    private NewOrderFormModel _model = new();
    private EditContext _editContext = null!;
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<ProductDto> _products = [];
    private int? _selectedCategoryId;
    private bool _isLoadingCatalogue = true;
    private bool _catalogueUnavailable;
    private bool _isSubmitting;
    private string? _successMessage;
    private string? _errorTitle;
    private string? _errorMessage;
    private IReadOnlyList<string> _serverValidationErrors = [];

    private IReadOnlyList<ProductDto> ActiveProducts => _products.Where(product => product.IsActive).ToList();

    private IReadOnlyList<ProductDto> VisibleProducts => ActiveProducts
        .Where(product => _selectedCategoryId is null || product.CategoryId == _selectedCategoryId)
        .ToList();

    private string ItemCountLabel => _model.ItemCount == 1 ? "1 item" : $"{_model.ItemCount} items";

    private bool _canReloadCatalogue => !_isLoadingCatalogue && !_catalogueUnavailable;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);
        await LoadCatalogueAsync();
    }

    private async Task LoadCatalogueAsync()
    {
        _isLoadingCatalogue = true;
        _catalogueUnavailable = false;
        ClearError();

        try
        {
            var categoriesTask = OrdersApiClient.GetCategoriesAsync();
            var productsTask = OrdersApiClient.GetProductsAsync(isActive: true);
            await Task.WhenAll(categoriesTask, productsTask);

            _categories = categoriesTask.Result;
            _products = productsTask.Result.Where(product => product.IsActive).ToList();
            if (_selectedCategoryId.HasValue && _categories.All(category => category.CategoryId != _selectedCategoryId.Value))
            {
                _selectedCategoryId = null;
            }
        }
        catch (OrdersApiException exception)
        {
            _catalogueUnavailable = true;
            SetError("Catalogue unavailable", "We could not load products right now. Please try again.", exception);
        }
        finally
        {
            _isLoadingCatalogue = false;
        }
    }

    private void SelectCategory(int? categoryId)
    {
        _selectedCategoryId = categoryId;
        _successMessage = null;
    }

    private void AddProduct(ProductDto product)
    {
        _model.AddProduct(product);
        NotifyItemsChanged();
        ClearMessages();
    }

    private void IncrementProduct(int productId)
    {
        _model.Increment(productId);
        NotifyItemsChanged();
        ClearMessages();
    }

    private void DecrementProduct(int productId)
    {
        _model.Decrement(productId);
        NotifyItemsChanged();
        ClearMessages();
    }

    private void RemoveProduct(int productId)
    {
        _model.Remove(productId);
        NotifyItemsChanged();
        ClearMessages();
    }

    private void ClearOrder()
    {
        _model.Clear();
        NotifyItemsChanged();
        ClearMessages();
    }

    private async Task PlaceOrderAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        ClearMessages();

        try
        {
            var order = await OrdersApiClient.CreateOrderAsync(_model.ToCreateOrderRequest());
            _successMessage = $"Order #{order.OrderId} was placed for {order.OrderName}.";
            ResetForm();
        }
        catch (OrdersApiException exception)
        {
            SetError(
                "Order not placed",
                "The order could not be placed. Review the details and try again.",
                exception);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        ClearMessages();
    }

    private void ResetForm()
    {
        _model = new NewOrderFormModel();
        _editContext = new EditContext(_model);
    }

    private void NotifyItemsChanged() =>
        _editContext.NotifyFieldChanged(new FieldIdentifier(_model, nameof(NewOrderFormModel.Items)));

    private string CategoryButtonClass(int? categoryId) =>
        _selectedCategoryId == categoryId ? "category-button-selected" : string.Empty;

    private void SetError(string title, string fallbackMessage, OrdersApiException exception)
    {
        _errorTitle = title;
        _errorMessage = fallbackMessage;
        _serverValidationErrors = exception.ValidationErrors.Values.SelectMany(errors => errors).ToList();
        _successMessage = null;
    }

    private void ClearError()
    {
        _errorTitle = null;
        _errorMessage = null;
        _serverValidationErrors = [];
    }

    private void ClearMessages()
    {
        ClearError();
        _successMessage = null;
    }

    private static string FormatCurrency(decimal amount) => $"£{amount:0.00}";
}
